<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup before API 31. Patient records and field photos never leave the phone: the Room database (with its
   -wal/-shm files, hence the whole domain) and the case images in files/cases/.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="cases/" />
</full-backup-content>
