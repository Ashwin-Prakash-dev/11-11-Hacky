<?xml version="1.0" encoding="utf-8"?><!--
   API 31+: patient records and field photos are excluded from cloud backup and from device-to-device transfer: the Room
   database (with its -wal/-shm files, hence the whole domain) and the case images in files/cases/.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="cases/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="cases/" />
    </device-transfer>
</data-extraction-rules>
