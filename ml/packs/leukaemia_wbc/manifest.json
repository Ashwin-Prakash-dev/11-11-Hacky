{
  "contract_version": "1.0",
  "id": "leukaemia_wbc",
  "version": "1.1.1",
  "display_name": "B-ALL cell classification",
  "task_type": "classifier",
  "runtime": "onnx",
  "compute": "phone",
  "model": {"file": "model.onnx", "sha256": "280223d09fe2bd008be299d2e6b763e76bc1fbc4d7daa83de2afb4700e9889a5"},
  "input": {"tensor": "input_4", "shape": [1, 224, 224, 3], "layout": "NHWC", "dtype": "float32", "color": "RGB"},
  "preprocess": {
    "source": "cells", "cell_type": "wbc", "resize": "stretch", "scale": 1.0,
    "mean": [128.0, 128.0, 128.0], "std": [128.0, 128.0, 128.0], "stain_normalization": "none"
  },
  "output": {"decoder": "softmax", "labels": ["early_pre_b_like", "pre_b_like", "pro_b_like", "benign"]},
  "quality": {"min_blur": 8.0, "max_clipped_fraction": 0.45},
  "aggregation": {"image_score": "none", "min_fields": 1},
  "triage": {
    "provisional": true,
    "source": "Classification-only screening pack; no smear-level diagnostic or severity rule.",
    "rules": [{
      "id": "classification_only", "level": "NEEDS_EXPERT",
      "all": [{"metric": "count", "labels": ["early_pre_b_like", "pre_b_like", "pro_b_like", "benign"], "op": ">=", "value": 0}]
    }]
  },
  "uncertainty": {"method": "none"},
  "provenance": {
    "source": "MAmirEshraghi/Lightweight-Deep-CNN-Based-Mobile-App-in-the-Screening-of-ALL, commit 9477169349d2543a107c9f150d48cf6b5417fbdb",
    "licence": "CC BY-NC 4.0 (training data); model-code/artifact licence UNVERIFIED",
    "training_data": ["C-NMC 2019 B-ALL cell images"],
    "notes": "MobileNetV2 TFLite converted to ONNX opset 18 and final softmax removed. Upstream image-level metrics are not patient-grouped and are not DeepSight validation. For screening support only."
  }
}
